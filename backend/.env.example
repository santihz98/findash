# Copia este archivo a .env para desarrollo local (nunca commitees .env).
# En producción (Cloud Run), estas variables vienen de Secret Manager, no de este archivo.

# Postgres — para desarrollo local con docker-compose, usa las credenciales
# definidas en el docker-compose.yml de la raíz del repo. Puerto 5433 (no el
# 5432 por defecto de Postgres): docker-compose.yml lo remapea así a
# propósito para no chocar con un Postgres nativo que ya pueda estar
# corriendo en tu máquina.
DATABASE_URL="postgresql://findash:findash_dev_password@localhost:5433/findash?schema=public"

# Puerto en el que escucha el backend.
PORT=3000

# Entorno de ejecución.
NODE_ENV=development

# Auth (Sesión 2). Dos secretos DISTINTOS (access vs refresh) a propósito —
# ver TokenService (src/modules/auth/application/services/token.service.ts):
# así, aunque uno se filtre, el otro tipo de token sigue protegido. Genera
# los tuyos con `openssl rand -hex 32`; nunca reutilices estos valores de
# ejemplo fuera de tu máquina de desarrollo. En producción (Cloud Run) van
# en Secret Manager, igual que DATABASE_URL — nunca en este archivo ni
# hardcodeados en el código (el código usa ConfigService.getOrThrow, sin
# fallback, así que arranca fallando si faltan).
JWT_SECRET="dev-only-3610e205372f5b55f164ab9d66da99dc6dfa02d55101096e1ab19bbce1728f"
JWT_REFRESH_SECRET="dev-only-31a5e41587c0cd26fff19eca7ec40d1383007fed5ee53106ed7fd6193c699c"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — lista de orígenes permitidos separados por coma (parseCorsOrigins,
# src/shared/config/cors.config.ts). getOrThrow, sin fallback: la app no
# arranca sin esto. En producción (AWS) el valor real incluye además la URL
# del bucket S3 del frontend — ver README.md, sección "Checklist de AWS".
CORS_ORIGIN=http://localhost:4200
